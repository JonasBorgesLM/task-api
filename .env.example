# .env.example — copy this file to .env and adjust the values for your environment.
# The .env file is listed in .gitignore and must never be committed to version control.

# TCP address the HTTP server listens on, in host:port form.
# ":8080" binds to all interfaces on port 8080.
HTTP_ADDR=:8080

# http.Server timeouts. Accept any valid Go duration string: 5s, 500ms, 1m, etc.
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Maximum time to wait for in-flight requests during graceful shutdown.
HTTP_SHUTDOWN_TIMEOUT=10s

# Minimum severity that gets logged: debug, info, warn, or error.
# Case-insensitive; "warning" is accepted as a synonym for "warn".
#LOG_LEVEL=info

# Path to the .env file itself. Useful when the process runs from a
# different working directory than this file lives in (a systemd unit, a
# container with the config mounted elsewhere). Read from the real
# environment only — setting it inside a .env file has no effect, since
# the file has to be located before it can be parsed.
#DOTENV_PATH=.env

# PostgreSQL connection string. Leave unset to use the in-memory task store
# instead (useful for quick local runs or demos without a database).
# The docker-compose.yml in this repo starts a Postgres matching this URL:
#   docker compose up -d postgres
#DATABASE_URL=postgres://task_api:task_api@localhost:5432/task_api?sslmode=disable

# PostgreSQL connection pool tuning. Ignored when DATABASE_URL is unset.
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=25
#DB_CONN_MAX_LIFETIME=5m

# Whether to apply pending PostgreSQL migrations automatically on startup.
# Ignored when DATABASE_URL is unset. Consider setting this to false and
# running migrations as a separate deploy step in a multi-replica
# production deployment (see README's "PostgreSQL" section).
#DB_AUTO_MIGRATE=true

# How long a session token issued by POST /auth/login remains valid.
# Accepts any valid Go duration string: 30m, 24h, 168h (a week), etc.
#AUTH_SESSION_TTL=24h

# Comma-separated list of origins a browser-based client may call this API
# from. Leave unset to disable CORS entirely (the default when running
# `go run ./cmd/api` directly, correct for a server-to-server client, curl,
# or this project's own test suite). Needed only when a page running in a
# browser — at its own origin, different from this API's — calls it
# directly, e.g. the Swagger UI bundled in docker-compose.yml at
# http://localhost:8082 (see README's "Swagger UI" section).
#
# Running via `make docker-up` / `docker compose up` already sets this to
# http://localhost:8082 by default — see docker-compose.yml — so it does
# NOT need to be set here for that workflow; only for `go run ./cmd/api`
# on the host, or to override docker-compose.yml's default (e.g. because
# something other than the bundled Swagger UI needs to call this API from
# a browser, at a different origin):
#CORS_ALLOWED_ORIGINS=http://localhost:8082

# How long browsers should refuse to reach this API over plaintext
# (Strict-Transport-Security). Accepts any valid Go duration string;
# 8760h is a year, the usual production value.
#
# Leave unset — the default — unless HTTPS actually terminates in front of
# this process. This binary always serves plain HTTP (TLS terminates at a
# proxy in a real deployment), and a browser ignores the header entirely
# when it arrives over plaintext, so setting it here only means anything
# if something in front is doing TLS. Note it is close to a one-way door:
# a browser that has seen max-age=8760h refuses plaintext to this host for
# a year, and only serving HTTPS with max-age=0 walks that back.
# max-age carried by the Strict-Transport-Security response header.
# The header is now sent by default (one year) — a browser is required to
# ignore it over plain HTTP, so it is inert until TLS is actually in front
# of this process, and deciding per request from r.TLS would disable it
# behind the very TLS-terminating proxy it is meant for.
# Set to 0 to omit the header entirely, for a service that is deliberately
# and permanently plaintext. includeSubDomains and preload are never sent.
#HSTS_MAX_AGE=8760h

# Rate limiting. Three tiers, each a token bucket: BURST is how many
# requests may arrive at once, PER_SEC the sustained rate it refills at.
# All six must be positive — a zero is rejected rather than read as
# "unlimited", so a typo can only over-restrict.
#
# Global, keyed by client address, in front of every route except the
# health probes (which are exempt so a traffic burst can't be escalated
# into a restart loop by an orchestrator reading 429 as "unhealthy").
#
# NOTE: the key is r.RemoteAddr, never X-Forwarded-For — a forwarded
# header is written by the client and would let every request claim a
# fresh identity. Behind a reverse proxy that means every client shares
# one bucket, since RemoteAddr is then the proxy's address; raise these
# values accordingly, or see the trusted-proxy issue in the tracker.
#RATE_LIMIT_BURST=60
#RATE_LIMIT_PER_SEC=20

# Tighter tier for POST /auth/register and POST /auth/login, where an
# unauthenticated caller can burn a bcrypt comparison per request.
#AUTH_RATE_LIMIT_BURST=10
#AUTH_RATE_LIMIT_PER_SEC=0.05

# Keyed by authenticated user ID rather than address, so one account
# cannot multiply its allowance by connecting from many hosts. Applies to
# every authenticated route.
#USER_RATE_LIMIT_BURST=120
#USER_RATE_LIMIT_PER_SEC=40

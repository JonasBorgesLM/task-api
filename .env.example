# .env.example — copy this file to .env and adjust the values for your environment.
# The .env file is listed in .gitignore and must never be committed to version control.

# TCP address the HTTP server listens on, in host:port form.
# ":8080" binds to all interfaces on port 8080.
HTTP_ADDR=:8080

# http.Server timeouts. Accept any valid Go duration string: 5s, 500ms, 1m, etc.
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Maximum time to wait for in-flight requests during graceful shutdown.
HTTP_SHUTDOWN_TIMEOUT=10s

# How long to keep serving after SIGTERM, before refusing new
# connections. Default 0 — shut down immediately, which is right for a
# local run or docker-compose.
#
# Set it for an orchestrated deployment. Kubernetes removes a terminating
# pod from the Service and sends SIGTERM at the same time, and
# propagating that removal takes time; during the gap, traffic is still
# routed to this process. Stopping instantly refuses those requests — a
# rolling update configured for zero downtime still drops a handful.
# Measured on kind: 3 of 654 requests failed before this existed, 0 of
# 732 after.
#
# The orchestrator's grace period must cover this PLUS
# HTTP_SHUTDOWN_TIMEOUT.
#HTTP_PRE_SHUTDOWN_DELAY=5s

# Minimum severity that gets logged: debug, info, warn, or error.
# Case-insensitive; "warning" is accepted as a synonym for "warn".
#LOG_LEVEL=info

# Path to the .env file itself. Useful when the process runs from a
# different working directory than this file lives in (a systemd unit, a
# container with the config mounted elsewhere). Read from the real
# environment only — setting it inside a .env file has no effect, since
# the file has to be located before it can be parsed.
#DOTENV_PATH=.env

# PostgreSQL connection string. Leave unset to use the in-memory task store
# instead (useful for quick local runs or demos without a database).
# The docker-compose.yml in this repo starts a Postgres matching this URL:
#   docker compose up -d postgres
#DATABASE_URL=postgres://task_api:task_api@localhost:5432/task_api?sslmode=disable

# PostgreSQL connection pool tuning. Ignored when DATABASE_URL is unset.
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=25
#DB_CONN_MAX_LIFETIME=5m

# Whether to apply pending PostgreSQL migrations automatically on startup.
# Ignored when DATABASE_URL is unset. Consider setting this to false and
# running migrations as a separate deploy step in a multi-replica
# production deployment (see README's "PostgreSQL" section).
#DB_AUTO_MIGRATE=true

# How long a session token issued by POST /auth/login remains valid.
# Accepts any valid Go duration string: 30m, 24h, 168h (a week), etc.
#AUTH_SESSION_TTL=24h

# How many of a user's sessions stay alive at once. A login past the cap
# evicts that user's oldest session (by CreatedAt) rather than being
# refused — this project has no endpoint to list active sessions, so
# refusing the new login would leave the caller stuck. See
# docs/DECISIONS.md § "Limite de sessões: teto com evicção da mais
# antiga". POST /auth/logout-all deletes every session for an account at
# once, for a caller who suspects a token has leaked.
#AUTH_MAX_SESSIONS_PER_USER=10

# Comma-separated list of origins a browser-based client may call this API
# from. Leave unset to disable CORS entirely (the default when running
# `go run ./cmd/api` directly, correct for a server-to-server client, curl,
# or this project's own test suite). Needed only when a page running in a
# browser — at its own origin, different from this API's — calls it
# directly, e.g. the Swagger UI bundled in docker-compose.yml at
# http://localhost:8082 (see README's "Swagger UI" section).
#
# Running via `make docker-up` / `docker compose up` already sets this to
# http://localhost:8082 by default — see docker-compose.yml — so it does
# NOT need to be set here for that workflow; only for `go run ./cmd/api`
# on the host, or to override docker-compose.yml's default (e.g. because
# something other than the bundled Swagger UI needs to call this API from
# a browser, at a different origin):
#CORS_ALLOWED_ORIGINS=http://localhost:8082

# Signs the CSRF token issued to browser clients (cookie-authenticated
# writes — see docs/DECISIONS.md § "Autenticação: modo duplo (cookie
# httpOnly + Bearer)"). Only cmd/api needs this; cmd/migrate and cmd/seed
# ignore it. Must be at least 32 bytes and identical across every
# instance — a per-process random value would reject every token minted
# by a different replica. Generate one with, e.g.:
#   openssl rand -base64 32
# Never commit the real value — this line is intentionally left blank.
#CSRF_SECRET=

# Drops the Secure attribute from the session cookie and the CSRF cookie,
# so both work over plain http://localhost in local development. Never
# set true in production — it lets an active network attacker read and
# write either cookie over any plaintext request to this host.
#COOKIE_INSECURE=false

# How long browsers should refuse to reach this API over plaintext
# (Strict-Transport-Security). Accepts any valid Go duration string;
# 8760h is a year, the usual production value.
#
# Leave unset — the default — unless HTTPS actually terminates in front of
# this process. This binary always serves plain HTTP (TLS terminates at a
# proxy in a real deployment), and a browser ignores the header entirely
# when it arrives over plaintext, so setting it here only means anything
# if something in front is doing TLS. Note it is close to a one-way door:
# a browser that has seen max-age=8760h refuses plaintext to this host for
# a year, and only serving HTTPS with max-age=0 walks that back.
# max-age carried by the Strict-Transport-Security response header.
# The header is now sent by default (one year) — a browser is required to
# ignore it over plain HTTP, so it is inert until TLS is actually in front
# of this process, and deciding per request from r.TLS would disable it
# behind the very TLS-terminating proxy it is meant for.
# Set to 0 to omit the header entirely, for a service that is deliberately
# and permanently plaintext. includeSubDomains and preload are never sent.
#HSTS_MAX_AGE=8760h

# Rate limiting. Three tiers, each a token bucket: BURST is how many
# requests may arrive at once, PER_SEC the sustained rate it refills at.
# All six must be positive — a zero is rejected rather than read as
# "unlimited", so a typo can only over-restrict.
#
# Global, keyed by client address, in front of every route except the
# health probes (which are exempt so a traffic burst can't be escalated
# into a restart loop by an orchestrator reading 429 as "unhealthy").
#
#RATE_LIMIT_BURST=60
#RATE_LIMIT_PER_SEC=20

# Tighter tier for POST /auth/register and POST /auth/login, where an
# unauthenticated caller can burn a bcrypt comparison per request.
#AUTH_RATE_LIMIT_BURST=10
#AUTH_RATE_LIMIT_PER_SEC=0.05

# Keyed by authenticated user ID rather than address, so one account
# cannot multiply its allowance by connecting from many hosts. Applies to
# every authenticated route.
#USER_RATE_LIMIT_BURST=120
#USER_RATE_LIMIT_PER_SEC=40

# Reverse proxies this deployment operates, as a comma-separated list of
# CIDRs or bare addresses. Unset means no peer is trusted.
#
# The address-keyed rate limit tiers key on the TCP peer, never on
# X-Forwarded-For: that header is written by whoever sent the request, so
# believing it unconditionally lets a client mint a fresh rate-limit
# identity per request. Behind a proxy the peer is always the proxy,
# which collapses every client into one bucket — declaring the proxies
# here is what makes the forwarded header usable, since its right-hand
# end was then appended by your own infrastructure.
#
# List your PROXIES, never your clients: a client range here hands those
# clients the ability to choose their own bucket. 0.0.0.0/0 and ::/0 are
# rejected outright for that reason.
#TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Directory file attachments are stored under. Unset — the default —
# disables attachments entirely: the routes are not registered and
# requests to them return 404.
#
# There is deliberately no default path. The production image is a static
# binary on `scratch`, which has no writable filesystem at all, so a
# default would produce a deployment that accepts uploads and then fails
# every one of them. Naming the directory is also how you state that a
# volume is actually mounted there.
#
# The directory must already exist — the process will not create it, so a
# typo fails at startup instead of silently serving an empty tree.
#ATTACHMENT_STORAGE_DIR=./storage/attachments

# Largest single attachment accepted, in bytes. Default 10 MiB. Enforced
# while streaming to storage, not read from Content-Length, which the
# client writes and can understate.
#ATTACHMENT_MAX_BYTES=10485760

# Total bytes across every attachment one user owns, summed through all
# their tasks. Default 500 MiB (about fifty uploads at the single-file
# ceiling above). Checked before an upload streams in, using the total
# the caller already had — see docs/DECISIONS.md § "Quota de anexos" for
# why a single accepted upload can still push the total up to
# ATTACHMENT_MAX_BYTES past this ceiling.
#ATTACHMENT_MAX_BYTES_PER_USER=524288000

# How long a blob must have sat unreferenced before the orphan collector
# deletes it. Default 1h.
#
# This is a safety margin, not a tuning knob. Uploads write the bytes
# before the metadata row, so during that window a perfectly healthy
# upload looks exactly like an orphan — a file no row references. The
# value has to exceed the longest plausible gap between those two steps.
# Lowering it to reclaim space sooner trades against deleting uploads in
# flight, which is a far worse failure than a late reclaim.
#ATTACHMENT_ORPHAN_MIN_AGE=1h

# Object storage for attachments — the alternative to
# ATTACHMENT_STORAGE_DIR, not a complement to it. Setting both is
# rejected at startup: whichever lost would hold files the running
# process cannot see, and that surfaces as missing attachments rather
# than as a configuration error.
#
# Use this backend for any deployment where the process can move: a pod's
# local disk is not shared with the pod replacing it during a rolling
# update, and is gone if the pod is rescheduled onto another node. The
# filesystem backend stays for local development and the test suite,
# where needing no service at all is the point.
#
# The endpoint is host[:port] — no scheme. ATTACHMENT_S3_USE_SSL chooses
# https (default true; the local MinIO in docker-compose.yml is plain
# http, so set it false there).
#
# The bucket must already exist. The application does not create it, for
# the same reason it does not create the storage directory: silently
# creating one turns a typo into an empty bucket nobody notices, and in a
# shared account can mean creating it in the wrong place.
#ATTACHMENT_S3_ENDPOINT=localhost:9000
#ATTACHMENT_S3_BUCKET=task-api-attachments
#ATTACHMENT_S3_ACCESS_KEY=task_api
#ATTACHMENT_S3_SECRET_KEY=task_api_secret
#ATTACHMENT_S3_REGION=us-east-1
#ATTACHMENT_S3_USE_SSL=false

# Mirror every log record to an OTLP/HTTP collector (SigNoz, an OTel
# Collector, etc.), in addition to — never instead of — the stdout JSON
# log. Unset (the default) disables it entirely: nothing about logging
# changes.
#
# Full URL with scheme, and the collector's OTLP/HTTP port — 4318, not
# the gRPC port 4317; this exporter is OTLP/HTTP only. The default path
# /v1/logs is appended unless the URL already names one.
#
# Credential and TLS posture are not configurable yet — see
# docs/DECISIONS.md's Fase 11 section for why, and issue 11.6 for when.
#CRIER_OTLP_ENDPOINT=https://collector.example.com:4318

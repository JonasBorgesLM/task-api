# Version control and CI/tooling metadata — irrelevant to the build and
# no reason to ship it into the build context.
.git
.github
.claude

# Env files may contain local secrets and must never be sent to the
# Docker daemon or baked into an image layer. Configuration is supplied
# at `docker run` time via -e/--env-file instead (see Dockerfile).
.env
.env.*
!.env.example

# Build artifacts / local test output — never inputs to the build.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
task-api

# Go workspace files — local dev only, not part of the module build.
go.work
go.work.sum

# web/'s own build inputs/outputs — web/Dockerfile's node-builder stage
# runs `npm ci` and `npm run build` itself, from web/package*.json and
# web/ source, so a local node_modules or a stale dist here is never an
# input; sending either would only slow down the build context upload.
web/node_modules
web/dist
web/test-results

# Docker metadata itself.
Dockerfile
.dockerignore

# Editor/IDE.
.vscode
.idea

# Documentation — not needed inside the build context.
*.md
docs
LICENSE
